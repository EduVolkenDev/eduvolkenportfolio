---
const pageTitle = "Eduardo Volken — Portfolio";
const pageDescription = "Creative direction, digital design, branding, and premium web experiences.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#0d0416" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg: #0d0416;
      --bg-secondary: #1a0b2e;
      --text: rgba(255,255,255,.98);
      --muted: rgba(200,180,255,.75);
      --muted-2: rgba(200,180,255,.55);
      --pad: 20px;
      --max: 1200px;
      --accent: #a855f7;
      --accent-2: #06b6d4;
      --accent-3: #ec4899;
      --glow: rgba(168,85,247,.25);
      --glow-2: rgba(6,182,212,.2);
      --radius: 24px;
      --radius-sm: 16px;
      --shadow: 0 12px 40px rgba(168,85,247,.2);
      --transition: all .4s cubic-bezier(.4,0,.2,1);
    }

    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;background:var(--bg)}
    body{
      margin:0;min-height:100vh;color:var(--text);
      font:16px/1.65 "Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      -webkit-font-smoothing:antialiased;overflow-x:hidden;
      background:
        radial-gradient(ellipse 100% 60% at 50% -10%,rgba(168,85,247,.15),transparent),
        radial-gradient(ellipse 80% 100% at 0% 50%,rgba(6,182,212,.1),transparent),
        radial-gradient(ellipse 80% 100% at 100% 50%,rgba(168,85,247,.08),transparent),
        linear-gradient(180deg,var(--bg) 0%,var(--bg-secondary) 100%);
    }
    a{color:inherit;text-decoration:none;transition:var(--transition)}
    img{max-width:100%;height:auto;display:block}

    /* ── Page BG ── */
    .page-bg{position:fixed;inset:0;z-index:0;pointer-events:none;
      background-image:
        linear-gradient(rgba(168,85,247,.05) 1px,transparent 1px),
        linear-gradient(90deg,rgba(6,182,212,.05) 1px,transparent 1px);
      background-size:60px 60px;opacity:.4;
      animation:gridPulse 8s ease-in-out infinite}
    @keyframes gridPulse{0%,100%{opacity:.3}50%{opacity:.5}}
    @keyframes fadeInUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
    @keyframes wordmarkGlow{
      0%,100%{filter:drop-shadow(0 8px 32px rgba(168,85,247,.6)) drop-shadow(0 0 60px rgba(6,182,212,.4))}
      50%{filter:drop-shadow(0 8px 40px rgba(168,85,247,.8)) drop-shadow(0 0 80px rgba(6,182,212,.6))}
    }

    /* ── Topbar ── */
    .topbar{position:fixed;top:0;left:0;right:0;z-index:60;
      background:rgba(13,4,22,.85);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
      border-bottom:1px solid rgba(168,85,247,.2);box-shadow:0 4px 24px rgba(168,85,247,.1);
      padding-top:env(safe-area-inset-top)}
    .topbar__inner{max-width:var(--max);margin:0 auto;
      padding:12px calc(var(--pad) + env(safe-area-inset-right)) 12px calc(var(--pad) + env(safe-area-inset-left));
      display:flex;align-items:center;justify-content:space-between;gap:10px}
    .brand{display:inline-flex;align-items:center;gap:10px;min-width:0}
    .brand__mark{width:38px;height:38px;border-radius:10px;
      border:2px solid rgba(168,85,247,.4);
      background:radial-gradient(20px 20px at 30% 30%,rgba(168,85,247,.5),transparent 70%),
        radial-gradient(24px 24px at 70% 70%,rgba(6,182,212,.4),transparent 70%),
        linear-gradient(135deg,rgba(168,85,247,.2),rgba(6,182,212,.15));
      box-shadow:0 8px 32px rgba(168,85,247,.4),inset 0 1px 2px rgba(255,255,255,.1);
      display:grid;place-items:center;flex:0 0 auto;
      color:#fff;font-weight:900;text-shadow:0 0 10px rgba(168,85,247,.8)}
    .brand__text{display:grid;line-height:1.1;min-width:0}
    .brand__text strong{font-size:13px;letter-spacing:1px;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .brand__text span{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

    .nav{display:none;gap:10px;align-items:center}
    .chip{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:999px;
      background:linear-gradient(135deg,rgba(168,85,247,.25),rgba(6,182,212,.2));
      border:1px solid rgba(168,85,247,.4);color:rgba(255,255,255,.95);font-size:13px;
      box-shadow:0 4px 16px rgba(168,85,247,.3),inset 0 1px 1px rgba(255,255,255,.1);
      white-space:nowrap;font-weight:600;backdrop-filter:blur(10px);transition:var(--transition);cursor:pointer}
    .chip:hover{background:linear-gradient(135deg,rgba(168,85,247,.4),rgba(6,182,212,.35));
      border-color:rgba(168,85,247,.6);box-shadow:0 6px 20px rgba(168,85,247,.5);transform:translateY(-2px)}

    .menuBtn{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:999px;
      background:rgba(168,85,247,.1);border:1px solid rgba(168,85,247,.3);
      box-shadow:0 4px 16px rgba(168,85,247,.2);cursor:pointer;color:var(--text);font-size:18px;transition:var(--transition)}
    .menuBtn:hover{background:rgba(168,85,247,.2);border-color:rgba(168,85,247,.5)}

    .drawer{display:none;border-top:1px solid rgba(168,85,247,.2);background:rgba(13,4,22,.9);backdrop-filter:blur(20px)}
    .drawer.open{display:block}
    .drawer__inner{max-width:var(--max);margin:0 auto;padding:10px var(--pad) 14px;display:flex;flex-wrap:wrap;gap:10px}

    /* ── Layout ── */
    .wrap{position:relative;z-index:1;min-height:100svh;display:flex;flex-direction:column;padding-top:70px}
    .shell{max-width:var(--max);margin:0 auto;padding:20px var(--pad) 40px;width:100%}

    /* ── Hero ── */
    .hero{padding:30px clamp(20px,8vw,147px);border-radius:40px;
      background:radial-gradient(ellipse 200px 300px at 50% 50%,#5e05b78a,transparent 20%,black 120%,#34074e8c 290%);
      border:2px outset rgba(255,255,255,.3);backdrop-filter:blur(15px);-webkit-backdrop-filter:blur(10px);
      max-width:1200px;display:grid;justify-content:center;width:auto;height:auto;margin:40px auto;text-align:center}
    .hero__icon{max-width:160px;margin:0 auto 20px;filter:drop-shadow(0 8px 32px rgba(168,85,247,.6))}
    .hero h1{font-size:clamp(36px,8vw,64px);line-height:1.05;letter-spacing:-.5px;font-weight:900;
      background:linear-gradient(135deg,#fff 0%,rgba(168,85,247,1) 50%,rgba(6,182,212,1) 100%);
      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:16px}
    .hero__subtitle{font-size:clamp(16px,3vw,22px);color:var(--muted);max-width:640px;margin:0 auto 16px;font-weight:500;line-height:1.5}
    .hero__text{font-size:15px;color:var(--muted-2);max-width:560px;margin:0 auto 28px;line-height:1.7}
    .hero__cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}

    /* ── Buttons ── */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;
      padding:14px 28px;border-radius:12px;border:1px solid rgba(168,85,247,.5);
      background:linear-gradient(135deg,rgba(168,85,247,.9),rgba(6,182,212,.8));
      box-shadow:0 8px 24px rgba(168,85,247,.4),inset 0 1px 2px rgba(255,255,255,.2);
      font-weight:700;letter-spacing:.3px;cursor:pointer;transition:var(--transition);
      position:relative;overflow:hidden;color:#fff}
    .btn::before{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;
      background:linear-gradient(90deg,transparent,rgba(255,255,255,.3),transparent);transition:left .5s}
    .btn:hover::before{left:100%}
    .btn:hover{background:linear-gradient(135deg,rgba(168,85,247,1),rgba(6,182,212,.95));
      box-shadow:0 12px 32px rgba(168,85,247,.6);transform:translateY(-2px)}
    .btn--ghost{background:rgba(168,85,247,.1);border:1px solid rgba(168,85,247,.3);
      box-shadow:0 4px 16px rgba(168,85,247,.2);backdrop-filter:blur(10px)}
    .btn--ghost:hover{background:rgba(168,85,247,.2);box-shadow:0 8px 24px rgba(168,85,247,.35)}

    /* ── Sections ── */
    section{margin-bottom:60px}
    .section-title{font-size:clamp(28px,5vw,40px);font-weight:900;
      background:linear-gradient(135deg,#fff 0%,rgba(168,85,247,1) 100%);
      -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
      margin-bottom:12px;text-align:center}
    .section-subtitle{color:var(--muted);text-align:center;max-width:600px;margin:0 auto 40px;font-size:16px}

    /* ── Card ── */
    .card{padding:32px;border-radius:var(--radius);
      background:radial-gradient(600px 800px at 40% 20%,rgba(113,17,205,.4),transparent 90%),
        linear-gradient(50deg,rgba(111,6,182,.6),rgba(18,202,233,.24));
      border:2px outset rgba(168,85,247,.4);
      box-shadow:0 12px 40px rgba(168,85,247,.2),inset 0 1px 2px rgba(255,255,255,.03);
      backdrop-filter:blur(20px);transition:var(--transition)}
    .card:hover{border-color:rgba(168,85,247,.4);box-shadow:0 16px 48px rgba(168,85,247,.3);transform:translateY(-4px)}

    /* ── About ── */
    .about-content{display:grid;gap:30px;align-items:center}
    .about-text p{color:var(--muted);line-height:2.1;margin-bottom:16px;font-size:18px}

    .about-image{border-radius:20px;overflow:hidden;border:2px solid rgba(168,85,247,.3);box-shadow:0 12px 40px rgba(168,85,247,.3)}

    /* ── Services ── */
    .services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
    .service-item{padding:20px 24px;border-radius:var(--radius-sm);
      background:rgba(168,85,247,.08);border:1px solid rgba(168,85,247,.25);transition:var(--transition)}
    .service-item:hover{background:rgba(168,85,247,.14);border-color:rgba(168,85,247,.4);transform:translateY(-3px);
      box-shadow:0 8px 24px rgba(168,85,247,.2)}
    .service-item h3{font-size:16px;font-weight:700;margin-bottom:6px}
    .service-item p{font-size:14px;color:var(--muted);line-height:1.6;margin:0}

    /* ── Projects ── */
    .projects-grid{display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
    .project-card{position:relative;border-radius:20px;overflow:hidden;
      background:linear-gradient(135deg,rgba(83,2,160,.89),rgba(6,182,212,.33));
      border:2px outset rgba(168,85,247,.4);transition:var(--transition);backdrop-filter:blur(10px)}
    .project-card:hover{border-color:rgba(168,85,247,.5);box-shadow:0 16px 48px rgba(168,85,247,.4);transform:translateY(-8px)}
    .project-image{width:100%;height:300px;object-fit:contain;border-bottom:2px solid rgba(168,85,247,.2)}
    .project-content{padding:24px}
    .project-title{font-size:20px;font-weight:700;margin-bottom:8px;color:#fff}
    .project-description{color:var(--muted);font-size:14px;line-height:1.6;margin-bottom:16px}
    .project-tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
    .tag{padding:6px 12px;border-radius:999px;
      background:linear-gradient(135deg,rgba(168,85,247,.3),rgba(6,182,212,.25));
      border:1px solid rgba(168,85,247,.5);font-size:11px;color:rgba(255,255,255,.95);font-weight:600}
    .project-link{display:inline-flex;align-items:center;gap:6px;color:var(--accent-2);font-size:14px;font-weight:600;transition:var(--transition)}
    .project-link:hover{color:#fff;transform:translateX(4px)}

    /* ── Skills ── */
    .skills-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:16px}
    .skill-item{padding:20px;border-radius:var(--radius-sm);background:rgba(168,85,247,.1);
      border:1px solid rgba(168,85,247,.3);text-align:center;transition:var(--transition)}
    .skill-item:hover{background:rgba(168,85,247,.2);border-color:rgba(168,85,247,.5);
      transform:translateY(-4px);box-shadow:0 8px 24px rgba(168,85,247,.3)}
    .skill-icon{max-width:100%;width:100%;height:auto;box-shadow:0 0 35px aqua,0 0 25px inset aqua;
      margin:auto;border-radius:90px;scale:1.2;filter:saturate(1) contrast(1.4)}

    /* ── Timeline ── */
    .timeline{position:relative;padding-left:40px}
    .timeline::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;
      background:linear-gradient(180deg,rgba(168,85,247,.5),rgba(6,182,212,.5))}
    .timeline-item{position:relative;margin-bottom:40px;padding:24px;border-radius:var(--radius-sm);
      background:rgba(168,85,247,.08);border:1px solid rgba(168,85,247,.25);transition:var(--transition)}
    .timeline-item::before{content:'';position:absolute;left:-48px;top:24px;width:16px;height:16px;border-radius:50%;
      background:linear-gradient(135deg,var(--accent),var(--accent-2));
      border:3px solid var(--bg);box-shadow:0 0 0 4px rgba(168,85,247,.3)}
    .timeline-item:hover{background:rgba(168,85,247,.12);border-color:rgba(168,85,247,.4);transform:translateX(8px)}
    .timeline-date{display:inline-block;padding:6px 12px;border-radius:999px;
      background:linear-gradient(135deg,rgba(168,85,247,.3),rgba(6,182,212,.25));font-size:12px;font-weight:600;margin-bottom:12px}
    .timeline-title{font-size:18px;font-weight:700;margin-bottom:8px;color:#fff}
    .timeline-company{color:var(--accent-2);font-size:14px;font-weight:600;margin-bottom:12px}
    .timeline-description{color:var(--muted);font-size:14px;line-height:1.6}

    /* ── Approach ── */
    .approach-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}
    .approach-text{font-size:18px;color:var(--muted);line-height:2;white-space:pre-line}

    /* ── Contact ── */
    .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}
    .contact-info{display:flex;flex-direction:column;gap:16px}
    .contact-info p{color:var(--muted);font-size:17px;line-height:1.75}

    /* ── Footer ── */
    .footer{margin-top:auto;padding:32px var(--pad);color:rgba(200,180,255,.5);font-size:13px;text-align:center;
      border-top:1px solid rgba(168,85,247,.15)}

    /* ── Responsive ── */
    @media(min-width:760px){
      .menuBtn{display:none}.drawer{display:none!important}.nav{display:flex}
      .about-content{grid-template-columns:1fr 1fr}
    }
    @media(max-width:759px){
      .approach-grid,.contact-grid{grid-template-columns:1fr}
      .hero{padding:40px 20px}
      .projects-grid{grid-template-columns:1fr}
      .timeline{padding-left:30px}
      .timeline-item::before{left:-38px}
    }
    @media(max-width:560px){
      .hero__icon{max-width:120px}
    }
    @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
  </style>
</head>

<body>
  <div class="page-bg" aria-hidden="true"></div>

  <div class="wrap">
    <!-- ═══ TOPBAR ═══ -->
    <header class="topbar">
      <div class="topbar__inner">
        <a class="brand" href="/">
          <div class="brand__mark">EV</div>
          <div class="brand__text">
            <strong>Eduardo Volken</strong>
            <span id="brandSub">Creative Direction & Digital Design</span>
          </div>
